# Reddit needs no credentials — sources/reddit_source.py reads the public,
# unauthenticated search.rss feed (Reddit closed self-service API app
# registration in 2026; see the comment at the top of that file).

# --- GitHub (optional but recommended: raises search rate limit from 60/hr to 5000/hr) ---
# In GitHub Actions this is auto-filled from secrets.GITHUB_TOKEN — see workflow file.
GITHUB_TOKEN=

# --- Notifications (set at least one) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Calendar push (optional, see integrations/google_calendar.py) ---
# Only needed if you want live-push instead of / in addition to the .ics feed.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# --- LLM-powered smart parsing (Google Gemini, free tier) ---
# Free key: https://aistudio.google.com/apikey. If unset, opportunities
# fall back to the plain keyword/dateparser heuristic (still works, just
# less precise) — see processing/llm_parser.py.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Notion pipeline tracking + result-day reminders ---
# One-time manual setup (Notion has no CLI for this — see the top of
# integrations/notion_sync.py for the exact steps). setup.sh walks you
# through it and runs scripts/notion_create_database.py for you.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=

# --- webhook/app.py only (set on PythonAnywhere, not needed locally) ---
# TELEGRAM_WEBHOOK_SECRET: Telegram's secret_token, set via webhook/register.py.
# GH_DISPATCH_TOKEN / GH_REPO: used by /tara and /cron/trigger-hunt to fire
#   the Opportunity Hunter workflow via the GitHub API.
# CRON_TRIGGER_SECRET: shared secret for /cron/trigger-hunt — generate with
#   `python -c "import secrets; print(secrets.token_urlsafe(32))"` and give
#   the same value (as ?token=...) to your external scheduler (e.g.
#   cron-job.org), since GitHub's own `schedule:` trigger has proven
#   unreliable for this repo — see opportunity_hunter.yml's comment.
TELEGRAM_WEBHOOK_SECRET=
GH_DISPATCH_TOKEN=
GH_REPO=
CRON_TRIGGER_SECRET=
